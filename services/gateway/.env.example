# ============================================================================
# Red Salud Gateway — Environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in any missing secrets.
# `.env` is git-ignored.
# ============================================================================

# --- Bind address ---------------------------------------------------------
# `0.0.0.0` is required inside containers; for local dev `127.0.0.1` works.
HOST=127.0.0.1
PORT=8080

# --- CORS -----------------------------------------------------------------
# Comma-separated list. Add every browser origin that calls the gateway.
# Local dev ports for the focus apps:
#   3001 farmacia · 3002 medico · 3003 paciente · 3004 clinica
#   3005 laboratorio · 3006 secretaria · 3007 seguro · 3008 ambulancia · 3009 academia
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003

# --- Supabase (project: red-salud) ---------------------------------------
# Project ref: hwckkfiirldgundbcjsp
# Region:      us-east-1
SUPABASE_URL=https://hwckkfiirldgundbcjsp.supabase.co

# Anon (publishable) key — safe to expose to the browser.
# Used by the gateway to proxy unauthenticated PostgREST reads.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh3Y2trZmlpcmxkZ3VuZGJjanNwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjIyMDA4MjcsImV4cCI6MjA3Nzc3NjgyN30.6Gh2U3mx7NsePvQEYMGnh23DqhJV43QRlPvYRynO8fY

# --- Auth -----------------------------------------------------------------
# JWT verification uses Supabase's public JWKS endpoint (asymmetric ES256/RS256).
# The default URL is derived from SUPABASE_URL; override only if you proxy auth
# through a custom domain or for testing.
# SUPABASE_JWKS_URL=https://hwckkfiirldgundbcjsp.supabase.co/auth/v1/.well-known/jwks.json

# --- Logging --------------------------------------------------------------
# RUST_LOG=red_salud_gateway=debug,tower_http=info
