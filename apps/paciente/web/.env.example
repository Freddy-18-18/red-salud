NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# Rate limiter (A4) — pluggable backend.
# 'memory': single-instance dev. Counters reset per process restart, do NOT use
#           in multi-instance production (Vercel serverless).
# 'upstash': production. Requires UPSTASH_REDIS_REST_URL + _TOKEN below.
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opt-in CSRF escape hatch for local curl/integration tests (no Origin/Referer
# headers). Hostile origins are still blocked. Leave 'false' in production.
ALLOW_LOCALHOST_CSRF=false
