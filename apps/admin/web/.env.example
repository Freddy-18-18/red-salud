# Supabase — same project as the rest of the ecosystem
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, NEVER expose to the browser.
# Used for cross-domain admin reads/writes that bypass RLS.
# All operations using this key MUST be wrapped through lib/audit so they are logged.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated list of admin emails allowed for the very first bootstrap
# (only used by the bootstrap action — once admin_roles has rows, this is ignored).
ADMIN_BOOTSTRAP_EMAILS=

# Session lifetime in minutes (default 30 — short on purpose)
ADMIN_SESSION_TIMEOUT_MIN=30
